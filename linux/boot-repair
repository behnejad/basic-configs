# only adding efi entrypoint in bios when efi files exists in efi partition

sudo efibootmgr -c -d /dev/sda -p 1 -L Kubuntu -l '\EFI\kubuntu\shimx64.efi' # ..\grubx64.efi

# recreating efi partition and files inside it

sudo mount /dev/sda7 /mnt
sudo mount /dev/sda2 /mnt/boot/efi

mount -t efivarfs none /sys/firmware/efi/

for i in /dev /dev/pts /proc /sys /run; do sudo mount -B $i /mnt$i; done  

sudo mount --bind /dev /mnt/dev
sudo mount --bind /dev/pts /mnt/dev/pts
sudo mount --bind /proc /mnt/proc
sudo mount --bind /sys /mnt/sys

sudo chroot /mnt

grub-install /dev/sda
grub-install --recheck /dev/sda
update-grub2
